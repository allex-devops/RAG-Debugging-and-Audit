# copy to .env (which is git-ignored), uncomment ONE provider block and paste your key.
# Only needed for `--live`; the probes, faults and incident reproduction run offline without it.

# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-5.6-luna
# EMBED_MODEL=text-embedding-3-small

# --- Google Gemini, via its OpenAI-compatible endpoint ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-3.8-flash
# EMBED_MODEL=gemini-embedding-001

# similarity below which it answers "I don't know" (default 0.7); tune it for your embedding model
# RAGCHAT_MIN_SCORE=0.7
